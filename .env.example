# copy to .env and `export $(grep -v '^#' .env | xargs)` (or set the variables in your shell)
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/marketplace
PIPELINE_INPUT_DIR=data/kaggle
PIPELINE_INTERNAL_DIR=data/internal
PIPELINE_RAW_DIR=data/raw
# only change these if an API moves (e.g. Frankfurter now also serves https://api.frankfurter.dev/v1)
FX_BASE_URL=https://api.frankfurter.app
HOLIDAYS_BASE_URL=https://date.nager.at/api/v3
STATES_URL=https://brasilapi.com.br/api/ibge/uf/v1
API_ATTEMPTS=4
API_BACKOFF_BASE=1.0
